{
  "openapi": "3.1.0",
  "info": {
    "title": "Finding Hub API",
    "version": "0.2.0",
    "description": "Workspace-scoped review registry. Tenant identity derives exclusively from the bearer token. Administrative changes use the CSRF-protected browser interface."
  },
  "security": [
    {
      "workspaceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "workspaceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Shown-once workspace token: UUID.secret; scopes reviews:write, findings:read, findings:implement, requests:read, requests:analyse, requests:implement. Finding implementation requires both finding scopes; request analysis requires requests:read and requests:analyse; request implementation requires requests:read and requests:implement. Tokens cannot accept/cancel requests. Personal tech-lead tokens require X-Workspace-ID for workspace endpoints."
      }
    },
    "schemas": {
      "HandoffProposal": {
        "type": "object", "additionalProperties": false,
        "description": "At most 64 KiB. Saves a draft only. Implementation completion requires proposed availability and binds actual commit/PR. Human UI review and closure alone publish Open requests to configured consumers.",
        "required": ["summary", "contract", "compatibility", "availability", "availability_details", "targets"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "contract": {"type": "string", "minLength": 1, "maxLength": 16000},
          "compatibility": {"type": "string", "minLength": 1, "maxLength": 8000},
          "availability": {"enum": ["unknown", "proposed", "merged", "test_available", "production_available"]},
          "availability_details": {"type": "string", "minLength": 1, "maxLength": 2000},
          "implementation": {"type": "object", "additionalProperties": false, "required": ["commit_sha", "pull_request"], "properties": {"commit_sha": {"type": "string"}, "pull_request": {"type": "string", "maxLength": 1000}}},
          "targets": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["repository_external_id", "requirements", "acceptance_criteria"], "properties": {
            "repository_external_id": {"type": "string", "minLength": 1, "maxLength": 500},
            "requirements": {"type": "string", "minLength": 1, "maxLength": 8000},
            "acceptance_criteria": {"type": "string", "minLength": 1, "maxLength": 8000}
          }}}
        }
      },
      "RequestAnalysis": {
        "type": "object", "additionalProperties": false,
        "required": ["project_kind", "specification", "new_interfaces", "changed_interfaces", "breaking_changes"],
        "properties": {
          "project_kind": {"enum": ["backend", "frontend", "fullstack"]},
          "specification": {"type": "string", "minLength": 1, "maxLength": 64000},
          "new_interfaces": {"type": "string", "minLength": 1, "maxLength": 16000},
          "changed_interfaces": {"type": "string", "minLength": 1, "maxLength": 16000},
          "breaking_changes": {"type": "string", "minLength": 1, "maxLength": 16000}
        }
      },
      "TargetedEnvelope": {"$ref": "./targeted-revalidation.schema.json"},
      "ImplementationRequest": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["action", "revision", "request_id"],
            "properties": {
              "action": {"const": "claim"},
              "revision": {"type": "integer", "minimum": 0},
              "request_id": {"type": "string", "format": "uuid"}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["action", "attempt_id", "completion"],
            "properties": {
              "action": {"const": "complete"},
              "attempt_id": {"type": "string", "format": "uuid"},
              "completion": {
                "type": "object", "additionalProperties": false,
                "required": ["outcome", "comment", "report", "pull_request", "commit_sha", "base_branch"],
                "properties": {
                  "outcome": {"enum": ["succeeded", "failed"]},
                  "comment": {"type": "string", "minLength": 1, "maxLength": 8000},
                  "report": {"oneOf": [{"$ref": "#/components/schemas/TargetedEnvelope"}, {"type": "null"}]},
                  "pull_request": {"type": "string", "maxLength": 1000},
                  "commit_sha": {"type": "string"},
                  "base_branch": {"type": "string"}
                },
                "description": "Success additionally requires a clean resolved report for the matching commit/feature branch and a matching HTTPS PR to a different original base branch. Failure uses null report and available Git metadata. Maximum serialized completion size: 256 KiB."
              }
            }
          }
        ]
      },
      "ImportResult": {
        "type": "object",
        "required": ["import_id", "repository_id", "run_id", "created_findings", "updated_findings", "lifecycle_changes", "jira"],
        "properties": {
          "import_id": {"type": "string", "format": "uuid"},
          "repository_id": {"type": "string", "format": "uuid"},
          "organization_id": {"type": "string", "format": "uuid", "description": "Authenticated workspace; optional for older stored imports."},
          "repository_created": {"type": "boolean", "description": "Whether the original import transaction created the repository. A 200 replay creates nothing, even if the stored value is true. Optional for older stored imports."},
          "run_id": {"type": "string"},
          "created_findings": {"type": "integer", "minimum": 0},
          "updated_findings": {"type": "integer", "minimum": 0},
          "lifecycle_changes": {"type": "integer", "minimum": 0},
          "jira": {"type": "object", "properties": {"state": {"type": "string"}, "queued_deliveries": {"type": "integer", "minimum": 0}}}
        }
      },
      "ImportEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "repository",
          "source",
          "review",
          "remediations"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "repository": {
            "type": "object",
            "required": [
              "external_id",
              "name",
              "default_branch"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "maxLength": 500
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "default_branch": {
                "type": "string",
                "maxLength": 200
              },
              "clone_url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "commit_sha",
              "branch"
            ],
            "properties": {
              "commit_sha": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{7,64}$"
              },
              "branch": {
                "type": "string"
              }
            }
          },
          "review": {
            "$ref": "./review.schema.json"
          },
          "remediations": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Source-bound remediation schema 1.0; see specification section 7.3."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/requests": {
      "get": {
        "operationId": "listProjectRequests",
        "description": "Requires requests:read. Tenant and repository restricted, active projects only, pages of 50. Unassigned requests are excluded.",
        "parameters": [
          {"in": "query", "name": "repository_external_id", "required": true, "schema": {"type": "string"}},
          {"in": "query", "name": "status", "schema": {"type": "string", "default": "open", "enum": ["open", "analyzed", "specified", "implemented", "closed", "cancelled"]}},
          {"in": "query", "name": "ids", "schema": {"type": "string"}, "description": "Optional comma-separated list of at most 100 request UUIDs."},
          {"in": "query", "name": "page", "schema": {"type": "integer", "minimum": 1, "default": 1}}
        ],
        "responses": {"200": {"description": "count, page, page_size and results including ID, project, kind, description, status, revision and analysis."}, "400": {"description": "Invalid filter"}, "403": {"description": "Insufficient scope"}}
      }
    },
    "/api/v1/requests/{id}/analysis": {
      "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {
        "operationId": "getRequestAnalysisContext",
        "description": "Requires requests:read; tenant and repository restrictions apply. Context includes related_projects (configured consumers) and upstream_handoff (approved snapshot intentionally shared with this target, or null).",
        "responses": {"200": {"description": "Current request context, revision and analysis"}, "404": {"description": "Not found or inaccessible"}}
      },
      "post": {
        "operationId": "submitRequestAnalysis",
        "description": "Requires requests:read and requests:analyse. Only Open requests at the supplied revision/project may become Analyzed. Exact submission retries are idempotent while current; changed or cancelled requests conflict. Does not accept, implement or cancel requests.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "additionalProperties": false,
          "required": ["revision", "repository_external_id", "submission_id", "analysis"],
          "properties": {"revision": {"type": "integer", "minimum": 1}, "repository_external_id": {"type": "string", "minLength": 1}, "submission_id": {"type": "string", "format": "uuid"}, "analysis": {"$ref": "#/components/schemas/RequestAnalysis"}}
        }}}},
        "responses": {"200": {"description": "Analyzed request or identical replay"}, "400": {"description": "Invalid analysis"}, "403": {"description": "Scope or workspace write restriction"}, "404": {"description": "Not found or inaccessible"}, "409": {"description": "Revision/project/state changed or conflicting replay"}, "429": {"description": "Rate limit"}}
      }
    },
    "/api/v1/requests/{id}/implementation": {
      "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {
        "operationId": "getRequestImplementationContext",
        "description": "Requires requests:read. Returns current request UUID, revision, project, kind, description, analysis, status, display_id (REQ-UUID), specification_digest, clone_url, related_projects and upstream_handoff. Claim additionally enforces Specified status. Optional completion handoff saves a draft only; human closure in the Hub is required to publish.",
        "responses": {"200": {"description": "Approved-specification context"}, "400": {"description": "Missing complete specification or active project"}, "403": {"description": "Insufficient scope"}, "404": {"description": "Absent or inaccessible"}}
      },
      "post": {
        "operationId": "implementRequest",
        "description": "Requires requests:read and requests:implement. Four-hour exclusive claim of a human-accepted Specified revision. Request edits/cancellation invalidate claims. Success records evidence/PR and marks Implemented, not Closed or merged; failure keeps Specified. Exact completed retries are idempotent. Maximum completion size 256 KiB; 60 requests/minute/workspace.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["action", "revision", "request_id", "repository_external_id"], "properties": {
              "action": {"const": "claim"}, "revision": {"type": "integer", "minimum": 1}, "request_id": {"type": "string", "format": "uuid"}, "repository_external_id": {"type": "string", "minLength": 1, "maxLength": 500}
            }},
            {"type": "object", "additionalProperties": false, "required": ["action", "attempt_id", "repository_external_id", "completion"], "properties": {
              "action": {"const": "complete"}, "attempt_id": {"type": "string", "format": "uuid"}, "repository_external_id": {"type": "string", "minLength": 1, "maxLength": 500},
              "completion": {"type": "object", "additionalProperties": false, "required": ["outcome", "comment", "report", "pull_request", "commit_sha", "base_branch"], "properties": {
                "outcome": {"enum": ["succeeded", "failed"]}, "comment": {"type": "string", "minLength": 1, "maxLength": 8000},
                "report": {"type": ["object", "null"], "description": "Success: request-verification schema_version 1.0, run_id UUID, repository_external_id, baseline {request_id UUID, revision, specification_digest sha256}, source {commit_sha, branch, snapshot_hash sha256, dirty false}, result {status satisfied, rationale, reviewer, evidence [{path,fact}], checks [{command,status,summary}], acceptance [{criterion,status,evidence}]}. Every check/criterion must pass; evidence/checks/acceptance each contain 1-100 bounded entries. Frozen digest/revision and exact feature/REQ-UUID commit must match claim. Failure: null. See docs/request_implementation_workflow.md and portable request_contract.py for complete validation."},
                "pull_request": {"type": "string", "maxLength": 1000}, "commit_sha": {"type": "string"}, "base_branch": {"type": "string"},
                "handoff": {"$ref": "#/components/schemas/HandoffProposal"}
              }}
            }}
          ]
        }}}},
        "responses": {"200": {"description": "Existing claim context or completion {attempt_id, request_id, status, comment, result {status,revision}}"}, "201": {"description": "New claim context with attempt_id and expires_at"}, "400": {"description": "Invalid evidence/input"}, "403": {"description": "Scope or workspace write restriction"}, "404": {"description": "Inaccessible request/claim/project"}, "409": {"description": "Stale/conflicting/cancelled/expired claim or specification"}, "429": {"description": "Rate limit"}}
      }
    },
    "/api/v1/review-imports": {
      "post": {
        "operationId": "importReview",
        "description": "Requires reviews:write; bounded to 10 MiB. Atomically creates a missing repository by external ID within the authenticated workspace, subject to token restrictions and quotas. Exact replays remain allowed after expiry.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "repository.external_id:review.run.run_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical replay of the stored original result; no new project or import created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportResult"}}}
          },
          "201": {
            "description": "New immutable import; missing repository created in the same transaction",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportResult"}}}
          },
          "400": {
            "description": "Contract validation failed"
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope, inactive subscription or exceeded allowance"
          },
          "409": {
            "description": "Same run identity with different content"
          },
          "413": {
            "description": "Body too large"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/review-imports/{id}": {
      "get": {
        "operationId": "getReviewImport",
        "description": "Requires findings:read. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/repositories": {
      "get": {
        "operationId": "listRepositories",
        "description": "Requires findings:read. Pages contain 50 items in created_at/UUID order.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/repositories/{id}": {
      "get": {
        "operationId": "getRepository",
        "description": "Requires findings:read. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/repositories/{id}/findings": {
      "get": {
        "operationId": "listRepositoryFindings",
        "description": "Requires findings:read. Pages contain 50 items in created_at/UUID order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verification_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/findings": {
      "get": {
        "operationId": "listFindings",
        "description": "Requires findings:read. Pages contain 50 items in created_at/UUID order. Items include display_id, to_implement and revision. Unlike the browser's default filter, the API only applies explicit filters.",
        "parameters": [
          {"name": "repository_external_id", "in": "query", "schema": {"type": "string"}, "description": "Exact stable project external ID, intersected with token restrictions."},
          {"name": "to_implement", "in": "query", "schema": {"type": "string", "enum": ["true"]}, "description": "Select only queued, open findings in active repositories."},
          {"name": "ids", "in": "query", "schema": {"type": "string"}, "description": "Comma-separated exact display IDs, at most 100. Does not broaden repository/token restrictions."},
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lifecycle",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verification_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/findings/{id}/implementation": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "get": {
        "operationId": "getFindingImplementationContext",
        "description": "Requires findings:read. Returns finding_id, display_id, repository_external_id, clone_url, fingerprint, revision, lifecycle, to_implement, baseline_observation_id, baseline_import_id, remediation and finding data.",
        "responses": {
          "200": {"description": "Current tenant-scoped source/proposal context"},
          "401": {"description": "Invalid token"},
          "403": {"description": "Insufficient scope"},
          "404": {"description": "Absent or inaccessible finding"}
        }
      },
      "post": {
        "operationId": "claimOrCompleteFindingImplementation",
        "description": "Requires findings:read AND findings:implement. Claim uses a unique request UUID and current revision, freezes the proposal and grants a four-hour exclusive lease. Complete binds the same token actor and appends history. Exact retries replay; cancelled, expired, changed or superseded state conflicts. Success resolves on an unmerged feature branch only; no project-grade or Jira update. GitHub /pull/{number} and Azure DevOps /_git/{repo}/pullrequest/{number} HTTPS URLs are accepted and bound to the configured clone URL. The client must independently verify source and PR; the Hub does not call either Git host.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImplementationRequest"}}}},
        "responses": {
          "200": {"description": "Claim replay (context, attempt_id, expires_at) or completion (activity_id, status, finding_id, comment, result lifecycle/to_implement)"},
          "201": {"description": "New exclusive claim; context plus attempt_id, expires_at and frozen remediation"},
          "400": {"description": "Invalid request, quota or evidence contract"},
          "401": {"description": "Invalid token"},
          "403": {"description": "Missing scope or inactive workspace entitlement"},
          "404": {"description": "Absent/inaccessible finding or claim"},
          "409": {"description": "Conflicting claim/replay, expired/cancelled claim, changed revision or baseline"},
          "429": {"description": "Rate limited"}
        }
      }
    },
    "/api/v1/findings/{id}/revalidation": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {
        "operationId": "revalidateSingleFinding",
        "description": "Requires reviews:write. Record one clean targeted result bound to the latest imported baseline and pre-verification revision. Idempotency uses report.run_id. Refuses an active implementation claim. Other findings, full-review observations, grades and Jira remain unchanged.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "additionalProperties": false, "required": ["revision", "report"],
          "properties": {"revision": {"type": "integer", "minimum": 0}, "report": {"$ref": "#/components/schemas/TargetedEnvelope"}}
        }}}},
        "responses": {
          "200": {"description": "Recorded result or identical replay: activity_id, status, finding_id, comment and result lifecycle/to_implement"},
          "400": {"description": "Invalid request, quota or targeted contract"},
          "401": {"description": "Invalid token"},
          "403": {"description": "Insufficient scope or workspace entitlement"},
          "404": {"description": "Absent/inaccessible finding"},
          "409": {"description": "Stale revision/baseline, active claim or conflicting run identity"},
          "429": {"description": "Rate limited"}
        }
      }
    },
    "/api/v1/findings/{id}": {
      "get": {
        "operationId": "getFinding",
        "description": "Requires findings:read. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
    "/api/v1/findings/{id}/observations": {
      "get": {
        "operationId": "listObservations",
        "description": "Requires findings:read. Pages contain 50 items in created_at/UUID order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
