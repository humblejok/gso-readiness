    "/api/v1/repositories/{id}/findings": {
      "get": {
        "operationId": "listRepositoryFindings",
        "description": "Requires findings:read. Pages contain 50 items in created_at/UUID order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
