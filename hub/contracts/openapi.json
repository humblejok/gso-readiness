{
  "openapi": "3.1.0",
  "info": {
    "title": "Finding Hub API",
    "version": "0.2.0",
    "description": "Workspace-scoped review registry. Tenant identity derives exclusively from the bearer token. Administrative changes use the CSRF-protected browser interface."
  },
  "security": [
    {
      "workspaceToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "workspaceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Shown-once workspace token: UUID.secret; scopes reviews:write, findings:read, findings:implement. Implementing requires both findings:read and findings:implement."
      }
    },
    "schemas": {
      "TargetedEnvelope": {"$ref": "./targeted-revalidation.schema.json"},
      "ImplementationRequest": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["action", "revision", "request_id"],
            "properties": {
              "action": {"const": "claim"},
              "revision": {"type": "integer", "minimum": 0},
              "request_id": {"type": "string", "format": "uuid"}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["action", "attempt_id", "completion"],
            "properties": {
              "action": {"const": "complete"},
              "attempt_id": {"type": "string", "format": "uuid"},
              "completion": {
                "type": "object", "additionalProperties": false,
                "required": ["outcome", "comment", "report", "pull_request", "commit_sha", "base_branch"],
                "properties": {
                  "outcome": {"enum": ["succeeded", "failed"]},
                  "comment": {"type": "string", "minLength": 1, "maxLength": 8000},
                  "report": {"oneOf": [{"$ref": "#/components/schemas/TargetedEnvelope"}, {"type": "null"}]},
                  "pull_request": {"type": "string", "maxLength": 1000},
                  "commit_sha": {"type": "string"},
                  "base_branch": {"type": "string"}
                },
                "description": "Success additionally requires a clean resolved report for the matching commit/feature branch and a matching HTTPS PR to a different original base branch. Failure uses null report and available Git metadata. Maximum serialized completion size: 256 KiB."
              }
            }
          }
        ]
      },
      "ImportResult": {
        "type": "object",
        "required": ["import_id", "repository_id", "run_id", "created_findings", "updated_findings", "lifecycle_changes", "jira"],
        "properties": {
          "import_id": {"type": "string", "format": "uuid"},
          "repository_id": {"type": "string", "format": "uuid"},
          "organization_id": {"type": "string", "format": "uuid", "description": "Authenticated workspace; optional for older stored imports."},
          "repository_created": {"type": "boolean", "description": "Whether the original import transaction created the repository. A 200 replay creates nothing, even if the stored value is true. Optional for older stored imports."},
          "run_id": {"type": "string"},
          "created_findings": {"type": "integer", "minimum": 0},
          "updated_findings": {"type": "integer", "minimum": 0},
          "lifecycle_changes": {"type": "integer", "minimum": 0},
          "jira": {"type": "object", "properties": {"state": {"type": "string"}, "queued_deliveries": {"type": "integer", "minimum": 0}}}
        }
      },
      "ImportEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "repository",
          "source",
          "review",
          "remediations"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "repository": {
            "type": "object",
            "required": [
              "external_id",
              "name",
              "default_branch"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "maxLength": 500
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "default_branch": {
                "type": "string",
                "maxLength": 200
              },
              "clone_url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "commit_sha",
              "branch"
            ],
            "properties": {
              "commit_sha": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{7,64}$"
              },
              "branch": {
                "type": "string"
              }
            }
          },
          "review": {
            "$ref": "./review.schema.json"
          },
          "remediations": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Source-bound remediation schema 1.0; see specification section 7.3."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/review-imports": {
      "post": {
        "operationId": "importReview",
        "description": "Requires reviews:write; bounded to 10 MiB. Atomically creates a missing repository by external ID within the authenticated workspace, subject to token restrictions and quotas. Exact replays remain allowed after expiry.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "repository.external_id:review.run.run_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical replay of the stored original result; no new project or import created",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportResult"}}}
          },
          "201": {
            "description": "New immutable import; missing repository created in the same transaction",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportResult"}}}
          },
          "400": {
            "description": "Contract validation failed"
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope, inactive subscription or exceeded allowance"
          },
          "409": {
            "description": "Same run identity with different content"
          },
          "413": {
            "description": "Body too large"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/review-imports/{id}": {
      "get": {
        "operationId": "getReviewImport",
        "description": "Requires findings:read. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Insufficient scope"
          },
          "404": {
            "description": "Absent or inaccessible workspace object"
          }
        }
      }
    },
