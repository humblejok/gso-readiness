# This file is a template. Django does not implicitly load .env.
# Export variables in your shell, or use docker compose --env-file .env.
HUB_ENV=development
HUB_PUBLIC_URL=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a random secret of >=50 characters for production.
DJANGO_SECRET_KEY=REPLACE_ME
DATABASE_URL=postgresql://hub:REPLACE_ME@db:5432/hub
POSTGRES_PASSWORD=REPLACE_ME
HUB_DEPLOYMENT_MODE=shared
HUB_TRUST_PROXY=false
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
HUB_SOURCE_URL=https://github.com/REPLACE_ME/REPLACE_ME/tree/RELEASE_TAG/hub
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Finding Hub <noreply@example.invalid>
HUB_BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON maps plan:interval to an existing Stripe Price ID. Set real prices in Stripe.
STRIPE_PRICES={}
OUTBOUND_INTEGRATIONS_ENABLED=false
JIRA_ALLOWED_HOSTS=
JIRA_PRIVATE_HOSTS=
JIRA_CA_BUNDLE=
# Comma-separated Fernet keys, newest first. Keep separate from database/backups.
HUB_ENCRYPTION_KEYS=
